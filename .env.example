# URL pública del sitio (sin "/" final). Se usa en metadatos y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (opcional). Sin estas dos, el sitio usa el contenido de src/content.
# URL del proyecto SIN /rest/v1/ al final: https://<ref>.supabase.co
# Clave: "anon public" o "sb_publishable_..." (es pública por diseño; la RLS protege).
# Nunca commitear valores reales.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # solo servidor; nunca en Vercel ni en NEXT_PUBLIC_*


# Enlaces temporales para vistas previas (docs/COMPARTIR-VISTA-PREVIA.md).
# Solo en Vercel → Preview. Con esta variable, el sitio se ve solo con un enlace vigente.
# SHARE_LINK_SECRET=
