# URL pública del sitio (sin "/" final). Se usa en metadatos y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (opcional). Sin estas dos, el sitio usa el contenido de src/content.
# URL del proyecto SIN /rest/v1/ al final: https://<ref>.supabase.co
# Clave: "anon public" o "sb_publishable_..." (es pública por diseño; la RLS protege).
# Nunca commitear valores reales.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # solo servidor; nunca en Vercel ni en NEXT_PUBLIC_*


# Enlaces temporales para vistas previas (docs/COMPARTIR-VISTA-PREVIA.md).
# Solo en Vercel → Preview. Con esta variable, el sitio se ve solo con un enlace vigente.
# SHARE_LINK_SECRET=


# Rutas por calles del recorrido en vivo (src/app/api/ruta). Todo opcional: por
# defecto usa los servidores públicos de FOSSGIS (datos de OpenStreetMap; uso
# justo: 1 consulta por segundo, sin uso intensivo). Para más tráfico, apuntar a
# un servidor OSRM propio o a otro proveedor (src/lib/routing).
# ROUTING_OSRM_WALK_URL=https://routing.openstreetmap.de/routed-foot
# ROUTING_OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
# ROUTING_USER_AGENT=PapudoEnTuMano/1.0 (+https://github.com/Matichoc/city_tour; contacto)
# ROUTING_MAX_PER_MINUTE=40

# Comentarios y archivos de visitantes (docs/DISENO-ABUSE-01-02.md). Solo servidor.
# REVIEW_GATE_SECRET: firma las pruebas que exige la base de datos para crear
#   comentarios. Mismo valor que en private.gate_secrets (supabase/manual/
#   cargar-secreto-comentarios.sql). Al menos 32 caracteres; sin esto los
#   comentarios no se envían.
# REVIEWS_SALT: sal de la huella anónima del remitente. Obligatoria; sin ella los comentarios no se envían.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY: Cloudflare Turnstile
#   (gratis). Sin ellas no se pide la comprobación.
# REVIEW_GATE_SECRET=
# REVIEWS_SALT=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
